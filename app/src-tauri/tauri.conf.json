{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athanor",
  "version": "0.1.6",
  "identifier": "dev.athanor.browser",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http: athanor-asset: http://athanor-asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost athanor-asset: http://athanor-asset.localhost; frame-src athanor-ext: http://athanor-ext.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RjY5MzAwRkEzNDRGMEYKUldRUFR6VDZBSlAyTiswSXlvazVMOU1wYnFnekNuNVlDR1Z1ZVFJT3hMemJLMXVSb3kyWHovTmQK",
      "endpoints": ["https://github.com/bata-san/Athanor/releases/download/updater/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A lightweight Chromium-based browser",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
